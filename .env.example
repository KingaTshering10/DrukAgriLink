# Supabase — copy to .env.local and fill with YOUR project values.
# Never commit real values. Get these from Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Used by the seed helper if you script it. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
